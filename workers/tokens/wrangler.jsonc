{
  "$schema": "../../web/node_modules/wrangler/config-schema.json",
  // Builds the "any token" list every fifteen minutes and writes it to KV. The site reads that one key, so a
  // visitor's request never makes a hundred chain calls.
  "name": "tickr-tokens",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // the ten minute keeper schedule is off: no more collectFees, treasury.collect or buy.
  // the fifteen minute token list still runs, it only writes KV.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "TICKR_KV", "id": "28581ee68ee442759cca8922c61d7dfb" }],
  // upload accounting for the site: shared counters in one Durable Object per name (v1 and v2 are the earlier shape, kept for the migration history)
  "durable_objects": { "bindings": [{ "name": "PIN_COUNTER", "class_name": "PinCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PinBudget"] }, { "tag": "v2", "deleted_classes": ["PinBudget"] }, { "tag": "v3", "new_sqlite_classes": ["PinCounter"] }],
  "vars": {
    "RPC_URL": "https://rpc.mainnet.chain.robinhood.com",
    "EXPLORER": "https://robinhoodchain.blockscout.com/api/v2",
    "WETH": "0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73",
    "USDG": "0x5fc5360D0400A0Fd4f2af552ADD042D716F1d168",
    "V3_FACTORY": "0x1f7d7550B1b028f7571E69A784071F0205FD2EfA",
    "POOL_MANAGER": "0x8366a39CC670B4001A1121B8F6A443A643e40951",
    "MULTICALL3": "0xcA11bde05977b3631167028862bE2a173976CA11",
    "MARKET_QUOTE_LAUNCHER": "",
    "FACTORY": "0x12EF55f994E6eb6bd55eF55Ce63800cD4425A03f",
    "MARKET_DEPLOYER": "0x384fe3d736583597a1fc345758462933455a9516",
    "TICKER_LAUNCHER": "0x7f6c8bA781b5bDC499F2BA7501A2178508877649",
    "KEEPER_LOCKER": "0xDfD29cB10Ff0491CdF7896F75e54f4357F4a42b8",
    "KEEPER_TREASURY": "0x60C1276ff7fEB5bC15f6f05C23D9de12fa0E72BA",
    "KEEPER_COIN": "0x51d553Efd2E8D772AEe6d602A9ea26C56c9a6942",
    "KEEPER_NAME": "0xF9d30A05A63d795e3eF37b34143f33b2cBEf0f14",
    "KEEPER_V2_COIN": "0x49f39Ce9bEBC9047DF7266B55D98e46c84526942",
    "KEEPER_V2_NAME": "0xF3b977f5b0c3F03eb265D1b26BF0F8961c1bE4f7",
    "KEEPER_V2_TREASURY": "0x8dcaBBf003e3d8C187D18f0a38cB1ac906D3FE28",
    "KEEPER_ESCROW": "0xCf706542a17ee6C0Cc9595E3f49d9131aF3331ba",
    "KEEPER_HOLY_TREASURY": "0x29d6427dc78b9B405DFAA118A9D634cE4CEf73f4"
  }
}
