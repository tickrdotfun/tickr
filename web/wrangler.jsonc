{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The preview deployment: the site with NEXT_PUBLIC_DEMO=1, replaying the recorded fork.
  "name": "tickr-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true },
  "vars": { "TOKENS_URL": "https://tickr-tokens.tickrdotfun.workers.dev/" },
  "kv_namespaces": [
    // Next's own cache; the token list lives in the same namespace, written by the tickr-tokens Worker.
    { "binding": "NEXT_INC_CACHE_KV", "id": "28581ee68ee442759cca8922c61d7dfb" }
  ],
  "env": {
    "sepolia": {
      // the dress rehearsal: the full site against the Sepolia deployment. deleted after the rehearsal.
      "name": "tickr-sepolia",
      "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
      "observability": { "enabled": true },
      "vars": { "TOKENS_URL": "https://tickr-tokens.tickrdotfun.workers.dev/" },
      "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "28581ee68ee442759cca8922c61d7dfb" }]
    },
    "check": {
      // the owner's private look at the real site before the domain switch: the live build, the live guard, the live
      // secrets, under a workers.dev name the domain does not point at. deleted after the switch.
      "name": "tickr-check",
      "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
      "observability": { "enabled": true },
      "vars": { "TOKENS_URL": "https://tickr-tokens.tickrdotfun.workers.dev/" },
      "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "28581ee68ee442759cca8922c61d7dfb" }]
    },
    "live": {
      // tickrfun.gg: the full site against the real chain.
      "name": "tickr",
      "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
      "observability": { "enabled": true },
      "vars": { "TOKENS_URL": "https://tickr-tokens.tickrdotfun.workers.dev/" },
      "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "28581ee68ee442759cca8922c61d7dfb" }]
    }
  }
}
