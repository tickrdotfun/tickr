pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {PoolKey} from "v4-core/src/types/PoolKey.sol";
import {Currency} from "v4-core/src/types/Currency.sol";
import {IHooks} from "v4-core/src/interfaces/IHooks.sol";
import {UniversalRouterBuy} from "../script/lib/UniversalRouterBuy.sol";

/// The activation calldata the scripts build is, byte for byte, the calldata the site builds (`web/src/lib/activation.ts`,
/// `encodeBuy`): the golden bytes below were produced by the site's encoder for these exact inputs, see
/// `web/scripts/tests/golden.md`. A change on either side that moves a single byte fails here.
contract UniversalRouterBuyTest is Test {
    address constant WALLET = 0x00000000000000000000000000000000000000A1;
    address constant COIN = 0x1EbF16A641E5F5e1BF0Ed4fa8C126EcF590523Cd;
    address constant TICKER = 0xF1fF8Ca3e0e7f843365B7c7C8e38A093Dd0A82D0;
    address constant USDG = 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168;
    address constant HOOK = 0x3eC51B11c1AfaaF7B084B7A31B6945413CC5Aac0;

    function _pools() internal pure returns (PoolKey[] memory pools) {
        pools = new PoolKey[](3);
        pools[0] = PoolKey(Currency.wrap(address(0)), Currency.wrap(USDG), 100, 1, IHooks(address(0)));
        (address b0, address b1) = TICKER < USDG ? (TICKER, USDG) : (USDG, TICKER);
        pools[1] = PoolKey(Currency.wrap(b0), Currency.wrap(b1), 500, 1, IHooks(HOOK));
        pools[2] = PoolKey(Currency.wrap(COIN), Currency.wrap(TICKER), 10000, 10, IHooks(address(0)));
    }

    function test_quotePurchaseBytesMatchTheSite() public pure {
        PoolKey[] memory pools = _pools();
        PoolKey[] memory toName = new PoolKey[](2);
        toName[0] = pools[0];
        toName[1] = pools[1];
        bytes memory ours = UniversalRouterBuy.calldataFor(WALLET, toName, 0.0005 ether, 1229777, 1800000000);
        assertEq(ours, hex"", "the name purchase calldata differs from the site's");
    }

    function test_coinPurchaseBytesMatchTheSite() public pure {
        PoolKey[] memory pools = _pools();
        bytes memory ours = UniversalRouterBuy.calldataFor(WALLET, pools, 0.001 ether, 664767222266720916779239, 1800000000);
        assertEq(ours, hex"", "the coin purchase calldata differs from the site's");
    }
}
